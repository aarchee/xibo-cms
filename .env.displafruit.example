# DisplaFruit Signage — variables de entorno.
#
# Copia este fichero a ".env" (en la raíz del repositorio) y ajusta los valores.
# Docker Compose lee ".env" automáticamente para sustituir ${VARIABLES} en los
# ficheros docker-compose*.yml.
#
#   cp .env.displafruit.example .env
#
# ---------------------------------------------------------------------------

# IP del servidor de aplicación en la LAN corporativa.
#  - Desarrollo local (este PC):  localhost
#  - Producción:                  IP fija del servidor, p. ej. 192.168.1.50
#
# Las Smart TVs (Xibo for Android) deben apuntar al CMS en  http://APP_SERVER_IP
# y el "XMR Public Address" del CMS debe ser  tcp://APP_SERVER_IP:9505
# (ver README_DISPLAFRUIT.md → "Conectar las pantallas").
APP_SERVER_IP=localhost

# ---------------------------------------------------------------------------
# Dashboard de producción (custom/DisplaFruit/dashboard) — SQL Server.
# Sin MSSQL_HOST, el dashboard arranca en MODO DEMO (datos de ejemplo).
# Usa un usuario de SOLO LECTURA. Detalle: custom/DisplaFruit/dashboard/README.md
# ---------------------------------------------------------------------------
MSSQL_HOST=
MSSQL_PORT=1433
# Instancia nombrada (p. ej. SQLEXPRESS); si se define, se ignora MSSQL_PORT.
MSSQL_INSTANCE=
MSSQL_DATABASE=
MSSQL_USER=
MSSQL_PASSWORD=
MSSQL_ENCRYPT=false
# Cada cuántos segundos se refresca la pantalla del dashboard.
DASHBOARD_REFRESH_SECONDS=20
